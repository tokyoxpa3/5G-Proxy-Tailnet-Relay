<?xml version="1.0" encoding="utf-8"?>
<!-- relay/icon.jpg already contains its own rounded frame and wordmark, so the
     foreground stays empty and the artwork lives in the background layer.
     ic_launcher_background is padded into the 66dp safe zone: launchers zoom the
     108dp canvas and would otherwise crop the frame and the wordmark. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_relay" />
</adaptive-icon>
